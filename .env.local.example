# ============================================================
# SPOTIFY — Конфигурация окружения
# ============================================================

# 1. Google Gemini AI API
# Получите бесплатный ключ на https://aistudio.google.com/app/apikey
# При отсутствии ключа работает встроенный автономный AI-движок рекомендаций
GEMINI_API_KEY=**
GEMINI_MODEL=**

# 2. Telegram Bot Notifications
# Создайте бота через @BotFather и получите токен (например: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=**
# Ваш Chat ID или ID канала/группы (узнать можно через бота @userinfobot)
TELEGRAM_CHAT_ID=**

# 3. Веб-админка (/admin)
ADMIN_PASSWORD=**
